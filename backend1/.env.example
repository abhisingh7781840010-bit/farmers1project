# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/smart_agri_procurement

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_smart_agri_procurement_hackathon_2024
JWT_EXPIRE=7d

# OTP Email Delivery (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
OTP_FROM_EMAIL=your-email@gmail.com
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=change_this_otp_secret

# OTP Mobile SMS Delivery (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567

# Machine Learning Service (FastAPI / Python Service)
ML_SERVICE_URL=http://localhost:8000/predict-waiting-time
ML_SERVICE_TIMEOUT_MS=2000

# Queue & Center Defaults
DEFAULT_AVERAGE_PROCESSING_TIME=5
